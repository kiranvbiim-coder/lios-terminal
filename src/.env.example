# Local client server port (used when running the app directly, not via Electron)
PORT=5052

# ─── Desktop updates ───────────────────────────────────────────────────────
# Signed distribution builds require a customer-reachable HTTPS generic feed.
# There is intentionally no source-code default: set this to the directory
# that hosts latest-mac.yml/latest.yml and the corresponding signed artifacts.
# LIOS_UPDATE_URL=https://updates.example.com/lios/
#
# LiOS operates no normal customer intelligence/data runtime service. Accounts
# are local to the user-owned Home; entitlement uses a vendor-signed licence file.
# Datasets and BYOD/BYOAI credentials remain under user-owned runtime custody.
# Signed updates and explicitly selected external providers are separate network contacts.
# Current source uses one application/auth bundle, not separate control-plane/client bundles.
# Externally reachable https origin of THIS Home, used for your own identity provider's OIDC/SAML callbacks and browser
# SSO verification links (enterprise SSO only).
# LIOS_HOME_PUBLIC_URL=https://lios.example.com/
# LIOS_SAML_VERIFIER_URL=https://saml-verifier.example.com/verify
#
# Historical inactive vendor control-plane/Paddle inputs below are retained as
# migration reference only; GM-07 removed their customer runtime/checkout paths.
# Do not configure these to enable billing or a LiOS-operated customer service.
# LIOS_BILLING_SUCCESS_URL=https://www.example.com/lios/billing/success
# LIOS_BILLING_CANCEL_URL=https://www.example.com/lios/billing/cancel
# LIOS_BILLING_RETURN_URL=https://www.example.com/lios/account
# LIOS_SELF_SERVE_TRIALS=true
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT=production
# PADDLE_PRICE_STARTER=pri_...
# PADDLE_PRICE_PRO=pri_...
# PADDLE_PRICE_ENTERPRISE=pri_...
# Historical inactive website/control-plane price labels; no current Paddle
# checkout authority or runtime catalog is implied by these examples.
# LIOS_PRICE_LABEL_STARTER=US$...
# LIOS_PRICE_LABEL_PRO=US$...
# LIOS_PRICE_LABEL_ENTERPRISE=Contact sales
#
# ─── Historical inactive P3 vendor distribution/control-plane inputs ───────
# LIOS_PUBLIC_APP_URL=https://www.example.com/lios/
# LIOS_DOWNLOAD_MAC_URL=https://downloads.example.com/lios/LiOS.dmg
# LIOS_DOWNLOAD_WINDOWS_URL=https://downloads.example.com/lios/LiOS-Setup.exe
# LIOS_RELEASE_NOTES_URL=https://www.example.com/lios/releases/
# LIOS_PUBLIC_VERSION=1.0.0
# LIOS_RELEASE_CHANNEL=stable
#
# Historical inactive vendor telemetry input. Current diagnostics are local-first;
# any supported remote export requires explicit consent and redacted-only content.
# LIOS_TELEMETRY_ENABLED=false
#
# Historical vendor operations alert input; not a customer control-plane requirement.
# LIOS_OPERATIONS_ALERT_EMAIL=ops@example.com

# ─── User-owned remote Home deployment (unset for local/desktop use) ───────
# HOST=0.0.0.0 permits a user-owned Home behind its reviewed HTTPS reverse proxy.
# The default 127.0.0.1 is correct for the Electron-spawned local backend.
# This does not authorize a LiOS-operated customer runtime or public unprotected ingress.
# HOST=0.0.0.0
#
# Keep the Home data root persistent; ephemeral deployment storage can lose
# the generated per-Home session secret and invalidate sessions on restart.
# If an explicit secret is required, generate one with `openssl rand -hex 32`.
# SESSION_SECRET=
#
# LiOS trusts one reverse-proxy hop by default for remote production Homes. Override
# only with the exact hop count (1..5); never use an unbounded boolean trust.
# TRUST_PROXY=1
#
# Remote production forces Secure session cookies automatically. This override
# remains available for explicit local HTTPS testing.
# SESSION_COOKIE_SECURE=true
#
# Generic private API connectors block loopback/private/link-local/reserved
# destinations in remote production. Enable this only for a user-owned
# private integration after network/security review.
# LIOS_ALLOW_PRIVATE_CONNECTOR_NETWORKS=false

# ─── Real-time streaming quotes (optional) ─────────────────────────────────
# Free key from https://finnhub.io — enables live tick streaming for US
# watchlist symbols over the app's WebSocket instead of 15s polling. Packaged
# apps can instead put {"finnhubApiKey": "..."} in ~/.limuria-terminal/config.json.
# FINNHUB_API_KEY=...

# ─── BYOAI providers (optional) ────────────────────────────────────────────
# AI remains optional. Configure only the provider(s) you want to use. Keys
# can also be supplied through the local credential vault instead of env.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-large-latest
# GROQ_API_KEY=...
# GROQ_MODEL=llama-3.3-70b-versatile
# TOGETHER_API_KEY=...
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# OPENROUTER_API_KEY=...
# XAI_API_KEY=...
#
# Azure OpenAI additionally requires the endpoint and deployment name.
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment
# AZURE_OPENAI_API_VERSION=2024-10-21
#
# Ollama uses its local base URL as the provider credential/config value.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# LM Studio is supported as a first-class local OpenAI-compatible provider.
# Start LM Studio's local server and point LIOS at the version-root URL.
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=your-loaded-model-id
#
# Any server exposing an OpenAI-compatible /chat/completions API can be wired
# through this generic provider. The base URL should normally end at its API
# version root (for example https://inference.example.com/v1). The terminal
# appends /chat/completions. OPENAI_COMPATIBLE_MODEL is the default model;
# callers may still choose another model ID for that provider.
# OPENAI_COMPATIBLE_API_KEY=...
# OPENAI_COMPATIBLE_BASE_URL=https://inference.example.com/v1
# OPENAI_COMPATIBLE_MODEL=your-model-id

# ─── Local voice runtime (optional) ────────────────────────────────────────
# Desktop users can choose these files from Environment Setup without editing
# environment variables. These overrides are primarily for development/server
# environments. LiOS never silently downloads the executable/model.
# LIOS_WHISPER_CPP_BIN=/absolute/path/to/whisper-cli
# LIOS_WHISPER_MODEL=/absolute/path/to/ggml-model.bin
# LIOS_FFMPEG_BIN=/absolute/path/to/ffmpeg
#
# ─── Notification email (optional) ─────────────────────────────────────────
# Configure a user-owned SMTP destination for supported email notifications;
# see server/emailService.ts. Set ONE of the two forms below, not both.
# SMTP configuration does not provide mobile push or a vendor notification relay.
#
# The simplest form -- a single connection string most providers hand out
# directly (SendGrid, Postmark, a real SMTP relay, ...):
# SMTP_URL=smtps://user:pass@smtp.example.com:465
#
# Or the discrete alternative, for a provider that doesn't give you a URL:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_SECURE=false
#
# From-address shown on outgoing mail (either form):
# SMTP_FROM=Limuria Intelligence <noreply@limuria.com>

# ─── Wave D webhook delivery (optional) ────────────────────────────────────
# Comma-separated HTTPS origins or hosts that may receive confirmed Wave D
# notifications. Destinations outside this allow-list are rejected.
# WAVE_D_WEBHOOK_ALLOWLIST=hooks.example.com,https://events.example.com

# ─── User-owned Home database and first-owner setup ────────────────────────
# The desktop defaults to embedded PGlite. An always-on Home may use its own
# PostgreSQL, NAS or container volume. Keep the data root on persistent storage.
# DATABASE_URL=postgres://user:password@user-owned-host:5432/lios
# LIOS_DATA_ROOT=/data/lios
#
# No administrator account or password is shipped. On a fresh Home with
# HOST=0.0.0.0 and no users, startup creates a random 24-hour one-time token
# in LIOS_DATA_ROOT/owner-setup.token (0600), printing it once to the Home's
# console. Enter the token on the same-origin setup form over HTTPS. Direct
# loopback HTTP is also allowed. Restarts reuse the token; expiration requires
# a restart. It is deleted after successful setup.
#
# For unattended owner setup instead: supply BOTH the email and the absolute
# path of a read-only private file (0600 or 0400) containing one password line.
# Never put an owner password in an environment variable or container command.
# LIOS_OWNER_EMAIL=owner@example.com
# LIOS_OWNER_NAME=LiOS Owner
# LIOS_OWNER_PASSWORD_FILE=/run/secrets/lios_owner_password
#
# Reverse proxies must terminate HTTPS and be the ONLY ingress to the Home
# port. Set TRUST_PROXY=1 only behind that proxy; direct HTTP cannot submit
# the setup token except from the server's own loopback address.

# ─── User-owned PostgreSQL organization credential custody ─────────────────
# Required when DATABASE_URL is configured. Use a secret-manager value of at
# least 32 characters; do not reuse SESSION_SECRET or the local vault secret.
# LIMURIA_HOSTED_VAULT_SECRET=
# LIMURIA_CREDENTIAL_STORE=organization

# ─── Licences (GM-07b) ─────────────────────────────────────────────────────
# Customers import a vendor-signed licence file (npm run license:import -- file.lioslicense, or POST /api/license/import).
# It is verified against the public key pinned in shared/licenseTrust.ts and never contacts LiOS. A licence that names a
# device fingerprint (shown by npm run license:status) works only on that install; one without it works anywhere.
# Historical inactive hosted-issuer inputs below are not customer Home configuration;
# licence verification uses the pinned public trust key, not a customer-supplied issuer key.
# LIMURIA_DEVICE_BINDING_SECRET (optional): overrides the per-Home session secret for device-binding cookies.
# LIMURIA_LICENSE_SIGNING_PRIVATE_KEY=
# LIMURIA_LICENSE_SIGNING_PUBLIC_KEY=
# LIMURIA_LICENSE_SIGNING_KEY_ID=

# ─── User-owned remote Python runtime (optional) ───────────────────────────
# Requires HTTPS outside localhost and a bearer token. When configured, the
# Home uses this user-selected service instead of spawning a local sidecar.
# PYTHON_REMOTE_SERVICE_URL=https://python.example.com
# PYTHON_REMOTE_SERVICE_TOKEN=

# ── Object storage (GM-05) ───────────────────────────────────────────────────
# Project attachments are stored on the local filesystem in the data root by default.
#   LIOS_STORAGE_ENCRYPTION=on          encrypt blobs (AES-256-GCM) before they reach the disk; key = <data root>/data/storage.key
# To use your own S3-compatible bucket (AWS S3, R2, MinIO, Wasabi, B2, Spaces...). Blobs are ALWAYS encrypted by LiOS
# before upload; copy storage.key with your backups or the objects cannot be read.
#   LIOS_STORAGE_PROVIDER=s3
#   LIOS_S3_ENDPOINT=https://s3.example.com   (https only; http is accepted for localhost)
#   LIOS_S3_BUCKET=my-lios-home
#   LIOS_S3_REGION=us-east-1
#   LIOS_S3_ACCESS_KEY_ID=...
#   LIOS_S3_SECRET_ACCESS_KEY=...          or, preferred, a reference:  LIOS_S3_SECRET_ACCESS_KEY_REF=file:/run/secrets/s3_secret
#   LIOS_S3_PREFIX=optional/prefix
#   LIOS_S3_VIRTUAL_HOSTED=false

# ── Secret references (GM-07) ────────────────────────────────────────────────
# Anywhere LiOS stores a credential *name* (for example a data connection's credential reference) you may use a
# reference instead of a value: env:LIOS_SECRET_FRED_KEY, file:/run/secrets/fred, vault:fred_api_key (or a bare vault name).
#   env:   only variables whose names start with LIOS_SECRET_ can be referenced (so a reference can never read DATABASE_URL etc.)
#   file:  only private (0600), single-line files inside <data root>/secrets, /run/secrets, or LIOS_SECRET_FILE_DIRS
#   LIOS_SECRET_FILE_DIRS=/mnt/secrets:/opt/lios/secrets     (path-delimiter separated, absolute)
# SESSION_SECRET (optional): a random per-Home secret is generated in the data root if unset; set it only for multi-node Homes.

# ── Outbound network policy (GM-07d) ─────────────────────────────────────────
# Applies to process-wide server fetch and node:http/node:https request/get
# (first hop). Fetch redirects are re-checked hop by hop in allowlist/offline modes.
# Loopback sidecar/model services remain reachable; metadata/link-local is blocked
# unless explicitly allowed. This is not a whole-host network sandbox.
#   LIOS_EGRESS_MODE=open          (default) anything except metadata/link-local
#   LIOS_EGRESS_MODE=allowlist     only LIOS_EGRESS_ALLOW entries (redirects are re-checked hop by hop)
#   LIOS_EGRESS_MODE=offline       loopback plus LIOS_EGRESS_ALLOW entries only (for an air-gapped Home with a LAN model server)
#   LIOS_EGRESS_ALLOW=api.openai.com,*.sec.gov,192.168.1.20,10.0.0.0/8
# Not covered: raw sockets (including remote PostgreSQL), Playwright browser
# processes or native addons. Review those boundaries separately under GM-11/GM-14.

# ── Backups and data folder ──────────────────────────────────────────────────
# Configure backups in Settings → Backups (folder, schedule, encryption, Test restore) or with
# npm run backup:create|verify|extract|restore. Move the data folder in Settings → Data folder or with
# npm run data-root -- move <empty-folder>. LIOS_DATA_ROOT, when set, overrides the saved folder.
# LIMURIA_CREDENTIAL_STORE=organization   (optional) per-organization credentials in your PostgreSQL instead of the local vault

