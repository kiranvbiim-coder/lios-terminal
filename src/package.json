  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "bufferutil": "^4.0.8"
  },
  "build": {
    "appId": "com.limuria.terminal",
    "productName": "LiOS Intelligence Terminal",
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build-resources/icon.icns",
      "hardenedRuntime": true,
      "signIgnore": [
        ".*/native-runtime-dist/.*"
      ],
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExts": [
        ".exe"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.LIOS_UPDATE_URL}"
      }
    ],
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "desktopUpdater.cjs",
      "desktopWorkspace.cjs",
      "desktopCsp.cjs",
      "dataRootCore.cjs",
      "governedDataMigration.cjs",
      "desktopPort.cjs",
      "desktopRequestTrust.cjs",
      "preload.cjs",
      "desktopSecretCustody.cjs",
      "desktopArtifactDraftRecovery.cjs",
      "nativeDraftGrant.cjs",
      "desktopIpcSecurity.cjs",
      "desktopUnicodePdf.cjs",
      "desktopLogRedaction.cjs",
      "desktopBackupRestore.cjs",
      "desktopPythonSidecar.cjs",
      "desktopSandboxImage.cjs",
      "desktopSelfTest.cjs",
      "build-resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../third_party/licenses",
        "to": "legal/licenses"
      },
      "python-sidecar-dist/**/*",
      "sandbox-image-dist/**/*",
      "native-runtime-dist/**/*",
      "sandbox-image/CDLA-Permissive-2.0.txt",
      "script/**/*",
      "server/data/**/*",
      "migrations/**/*",
      "python-service/**/*",
      "!python-service/.venv/**",
      "!python-service/**/__pycache__/**",
      "!python-service/**/*.pyc",
      "!python-service/**/*.pyo",
      "!script/**/__pycache__/**",
      "!script/**/*.pyc",
      "!script/**/*.pyo"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "electronFuses": {
      "runAsNode": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "afterPack": "script/afterPackCopyNodeModules.cjs"
  }
